public class Solution {
    public ListNode detectCycle(ListNode head) {
        int milgya=0;
        ListNode slow=head;
        ListNode fast=head;
        while(fast!=null && fast.next!=null)
        {
            slow=slow.next;
            fast=fast.next.next;
            if(slow==fast)
            {
                milgya=1;
                break;
            }
        }
        if(milgya==1)
        {
            ListNode p1=head;
            ListNode p2=fast;
            while(p1!=p2)
            {
                p1=p1.next;
                p2=p2.next;
            }
            return p1;
        }
        else
        {
            return null;
        }
    }
}